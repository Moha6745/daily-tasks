{
  // إعداد نشر Cloudflare Pages.
  // ملفات الموقع في public/ وحدها؛ ما عداها (README، DEPLOY، package.json)
  // يبقى في المستودع ولا يصل إلى الموقع العام.
  // دوال المزامنة في functions/ وتُنشر كـ Pages Functions على مسار /api/*.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-tasks",
  "compatibility_date": "2026-10-11",
  "pages_build_output_dir": "public",

  // ربط قاعدة المزامنة.
  //
  // الربط هنا لا في لوحة Cloudflare، وهذا مُتحقَّق منه عملياً: `wrangler pages
  // deploy` يزامن إعداد الإنتاج من هذا الملف، فأي ربط يُضاف من اللوحة يُمحى
  // عند أول نشر — والأسرار تبقى لأن wrangler لا يديرها. ربطُ اللوحة يصلح
  // لمشروع يبنيه Cloudflare من Git، لا لمشروع يُرفع بـ wrangler.
  //
  // المعرّف أدناه ليس سرّاً: لا ينفع أحداً دون بيانات اعتماد الحساب. لكنه
  // يخصّ هذا الحساب، فمن ينسخ المستودع يُنشئ قاعدته ويستبدله:
  //   npm run db:create        ثم ضع المعرّف الذي يطبعه هنا
  // أو يحذف هذه الكتلة كلها، فتردّ /api/* بخطأ "not_configured" مفهوماً
  // ويعمل باقي الموقع كما هو. الجداول تُنشأ من الكود، فلا خطوة ترحيل.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "daily-tasks-sync",
      "database_id": "f8da9fa2-6114-4d96-9c96-4583a42dc7d0"
    }
  ]
}
