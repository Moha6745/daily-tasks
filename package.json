{
  "name": "daily-tasks",
  "version": "1.0.0",
  "private": true,
  "description": "تحدي الـ 30 — تطبيق المهام والعادات اليومية",
  "scripts": {
    "dev": "wrangler pages dev --d1 DB=daily-tasks-sync",
    "dev:static": "python3 -m http.server 8080 --directory public",
    "deploy": "wrangler pages deploy --project-name daily-tasks --branch main --commit-dirty=true",
    "preview": "wrangler pages deploy --project-name daily-tasks --branch preview --commit-dirty=true",
    "whoami": "wrangler whoami",
    "db:create": "wrangler d1 create daily-tasks-sync",
    "test:sync": "node tests/sync-api.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.42.0"
  }
}
